# ------------------------------------------------------------------
# Backend + data scripts configuration.
# Copy to `.env` (never commit it) and fill in the values.
# ------------------------------------------------------------------

# Qdrant endpoint.
#   Local (Qdrant running on your machine):  http://127.0.0.1:6333
#   Qdrant Cloud:  https://xxxxxxxx-xxxx.us-east4-0.gcp.cloud.qdrant.io
#   (Inside docker compose this is overridden to http://qdrant:6333.)
QDRANT_URL=http://127.0.0.1:6333

# Qdrant Cloud API key. Leave empty for a local Qdrant.
QDRANT_API_KEY=

# Name of the collection holding the papers.
QDRANT_COLLECTION=arxiv_papers

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Production example (your Render static site): https://arxiv-semantic-search.onrender.com
FRONTEND_URL=http://localhost:3000

# Sentence-embedding model (must produce 384-dim vectors unless you recreate the collection).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
